rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Connection health check
    match /test/{docId} {
      allow get: if true;
      allow write: if false;
    }

    // User profile documents
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isOwner(userId)
        && incoming().uid == userId
        && incoming().email is string
        && incoming().email.size() <= 256;

      allow update: if isOwner(userId)
        && incoming().uid == existing().uid;

      allow delete: if isOwner(userId);

      // User's private saved analysis reports
      match /analyses/{analysisId} {
        allow get: if isOwner(userId) && isValidId(analysisId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId)
          && isValidId(analysisId)
          && incoming().userId == userId
          && incoming().rawText is string
          && incoming().rawText.size() <= 50000
          && incoming().risk_level in ['low', 'moderate', 'high']
          && incoming().risk_score is number;

        allow update: if isOwner(userId)
          && isValidId(analysisId)
          && incoming().userId == existing().userId;

        allow delete: if isOwner(userId) && isValidId(analysisId);
      }
    }
  }
}
